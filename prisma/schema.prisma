  createdAt        DateTime @default(now()) @map("created_at")

  cliProfile CarrierCliProfile @relation(fields: [cliProfileId], references: [id], onDelete: Cascade)

  @@index([cliProfileId])
  @@map("carrier_cli_entries")
}

model CarrierRoutePolicy {
