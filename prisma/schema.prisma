  sipAccount    SipAccount?        @relation(fields: [sipAccountId], references: [id], onDelete: SetNull)
  phoneNumber   PhoneNumber?       @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  carrier       Carrier?           @relation(fields: [carrierId], references: [id], onDelete: SetNull)
