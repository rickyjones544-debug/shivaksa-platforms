// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KycRecordStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum CarrierType {
  API
  SIP_GATEWAY
}

enum CarrierAuthType {
  IP_AUTH
  CREDENTIAL_AUTH
}

enum CarrierStatus {
  TEST
  ACTIVE
  SUSPENDED
}

enum Transport {
  UDP
  TCP
  TLS
}

enum CliMode {
  FIXED
  POOL
  PASS_THROUGH
}

enum DestinationType {
  FIXED
  MOBILE
  ALL
}

// ============================================================================
// Provider CRM — wholesale carrier relationship management (internal)
// ============================================================================

enum ProviderLifecycleStage {
  PROSPECT
  CONTACTED
  IN_REVIEW
  COMMERCIAL_REVIEW
  TECHNICAL_REVIEW
  AGREEMENT_PENDING
  AGREEMENT_ACTIVE
  CONNECTIVITY_PENDING
  CONNECTIVITY_ACTIVE
  TRAFFIC_ACTIVE
  SUSPENDED
  INACTIVE
  CLOSED
}

enum ProviderContactRole {
  SALES
  NOC
  TECHNICAL
  BILLING
  RATES
  ACCOUNT_MANAGER
  OTHER
}

enum ProviderSubmissionStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

enum ProviderTaskType {
  FOLLOW_UP
  RATE_REQUEST
  CONNECTIVITY
  CLI
  CDR
  AGREEMENT
  BILLING
  TECHNICAL
  GENERAL
}

enum ProviderTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProviderDocumentCategory {
  COMPANY_DOCUMENT
  LICENSE
  RATE_CARD
  AGREEMENT
  TECHNICAL_DOCUMENT
  COMPLIANCE_DOCUMENT
  OTHER
}

// PENDING = uploaded against an onboarding link but not yet claimed by a
// submission; ATTACHED = part of a submitted intake snapshot (immutable).
enum ProviderSubmissionDocumentStatus {
  PENDING
  ATTACHED
}

// ============================================================================
// Requirements Center — Shivaksa's internal source of truth for what it
// requires from wholesale traffic providers. Org-owned, never provider-owned.
// ============================================================================

enum RequirementSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RequirementVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum RequirementVisibility {
  INTERNAL
  PUBLISHABLE
}

enum WholesaleProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ============================================================================
// Rate Desk — internal provider rate management. Structurally separate from
// the live Carrier/CarrierRate routing domain: nothing in this domain can
// activate routing, credentials, or traffic.
// ============================================================================

enum ProviderRateSheetStatus {
  RECEIVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum ProviderRateSheetVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum ProviderRateSheetSource {
  MANUAL
  EMAIL
  SUBMISSION
  SUBMISSION_DOCUMENT
  API
}

// Provider-rate row vocabulary. Distinct from carrier-domain DestinationType
// (FIXED/MOBILE/ALL), where ALL is a routing fallback — a provider rate marked
// BOTH prices fixed and mobile identically.
enum ProviderRateRouteType {
  FIXED
  MOBILE
  BOTH
}

// Phase 3: Multi-tenant foundation
// - User is global; authentication happens at the User level.
// - Organization is the tenant isolation boundary.
// - OrganizationMembership ties a User to an Organization with a Role.
// - Session captures the active membership context for a login.

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("PENDING") // ACTIVE, PENDING, SUSPENDED (global/platform status)
  isSuperAdmin Boolean  @default(false) @map("is_super_admin") // platform-wide super admin
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sessions        Session[]
  passwordResets  PasswordReset[]
  memberships     OrganizationMembership[]
  invitationsSent Invitation[]

  // CRM relations
  createdContacts  Contact[]
  createdLeads     Lead[]     @relation("CreatedLeads")
  assignedLeads    Lead[]     @relation("AssignedLeads")
  createdCampaigns Campaign[]
  createdNotes     Note[]

  // VoIP relations
  walletTransactions WalletTransaction[] @relation("WalletTransactionCreator")
  auditLogs          AuditLog[]          @relation("AuditLogActor")
  notifications      Notification[]
  reviewedKycRecords KycRecord[]         @relation("KycRecordReviewer")

  // Provider CRM relations
  onboardingLinksCreated      OnboardingLink[]     @relation("OnboardingLinkCreator")
  providerSubmissionsReviewed ProviderSubmission[] @relation("ProviderSubmissionReviewer")
  providerNotes               ProviderNote[]       @relation("ProviderNoteAuthor")
  providerTasksAssigned       ProviderTask[]       @relation("ProviderTaskAssignee")
  providerTasksCreated        ProviderTask[]       @relation("ProviderTaskCreator")

  // Requirements Center relations
  requirementSetsCreated      RequirementSet[]     @relation("RequirementSetCreator")
  requirementSetsUpdated      RequirementSet[]     @relation("RequirementSetUpdater")
  requirementVersionsCreated  RequirementVersion[] @relation("RequirementVersionCreator")
  requirementVersionsPublished RequirementVersion[] @relation("RequirementVersionPublisher")
  wholesaleProfilesCreated    WholesaleProfile[]   @relation("WholesaleProfileCreator")
  wholesaleProfilesUpdated    WholesaleProfile[]   @relation("WholesaleProfileUpdater")

  // Rate Desk relations
  providerRateSheetsCreated           ProviderRateSheet[]        @relation("ProviderRateSheetCreator")
  providerRateSheetVersionsPublished  ProviderRateSheetVersion[] @relation("ProviderRateSheetVersionPublisher")

  @@index([email])
  @@index([status])
  @@index([isSuperAdmin])
  @@map("users")
}

// Tenant isolation boundary. Every business record belongs to exactly one Organization.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMembership[]
  invitations Invitation[]

  // CRM relations
  contacts  Contact[]
  leads     Lead[]
  campaigns Campaign[]
  notes     Note[]

  // VoIP relations
  voipService   VoipService?
  wallet        Wallet?
  sipAccounts   SipAccount[]
  phoneNumbers  PhoneNumber[]
  voipCalls     VoipCall[]
  notifications Notification[]
  auditLogs     AuditLog[]
  kycRecord     KycRecord?

  // Multi-carrier wholesale VoIP
  carriers             Carrier[]
  carrierRoutePolicies CarrierRoutePolicy[]

  // Provider CRM relations
  providers            Provider[]
  onboardingLinks      OnboardingLink[]
  providerSubmissions  ProviderSubmission[]
  providerSubmissionDocuments ProviderSubmissionDocument[]

  // Requirements Center relations
  requirementSets      RequirementSet[]
  wholesaleProfile     WholesaleProfile?

  // Rate Desk relations
  providerRateSheets        ProviderRateSheet[]
  providerRateSheetVersions ProviderRateSheetVersion[]
  providerRates             ProviderRate[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// RBAC anchor: a user's role within a specific organization.
// A user may belong to multiple organizations with different roles.
model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  status         String   @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  joinedAt       DateTime @default(now()) @map("joined_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  sessions     Session[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_memberships")
}

// System + custom roles. isSystem prevents accidental deletion of built-in roles.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  memberships OrganizationMembership[]
  invitations Invitation[]

  @@index([name])
  @@map("roles")
}

// Permission definition. `key` is the canonical stable identifier used for
// lookups and assignment. scope/action/resource remain for documentation/grouping.
model Permission {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  key      String  @unique // canonical key, e.g. "crm:read:contacts"
  scope    String // e.g. "crm", "bpo", "admin"
  action   String // e.g. "read", "write", "delete", "manage"
  resource String? // e.g. "leads", "contacts"; null means all resources in scope

  roles RolePermission[]

  @@index([scope])
  @@map("permissions")
}

// Many-to-many join between Role and Permission.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Session model - server-side session storage.
// Phase 3: session now carries the active membership context for tenant routing/RBAC.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash    String   @unique @map("token_hash")
  userId       String   @map("user_id")
  membershipId String?  @map("membership_id") // active tenant context; nullable until chosen
  expiresAt    DateTime @map("expires_at")
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

// Password reset tokens - short-lived, one-time use.
model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}

// ============================================================================
// CRM Module — Step 3
// Every CRM record is scoped to an Organization. Notes may attach to contacts,
// leads, or campaigns, but always carry organizationId for tenant isolation.
// ============================================================================

model Contact {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  email          String?
  phone          String?
  company        String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  leads        Lead[]
  notes        Note[]

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("contacts")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  contactId      String?  @map("contact_id")
  title          String
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST, WON
  value          Decimal? @db.Decimal(12, 2)
  source         String?
  assignedToId   String?  @map("assigned_to_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo   User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("CreatedLeads", fields: [createdById], references: [id])
  campaigns    CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contactId])
  @@map("leads")
}

model Campaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String    @map("organization_id")
  name           String
  status         String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation(fields: [createdById], references: [id])
  leads        CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("campaigns")
}

// Join table between Campaigns and Leads. organizationId is denormalized for
// tenant-scoped queries and must match the owning campaign/lead organization.
model CampaignLead {
  id             String @id @default(dbgenerated("gen_random_uuid()"))
  campaignId     String @map("campaign_id")
  leadId         String @map("lead_id")
  organizationId String @map("organization_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
  @@map("campaign_leads")
}

model Note {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  content        String
  contactId      String?  @map("contact_id")
  leadId         String?  @map("lead_id")
  campaignId     String?  @map("campaign_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([campaignId])
  @@map("notes")
}

// ============================================================================
// Organization Invitations � Step 4
// Secure, expirable, single-use tokens for inviting users into organizations.
// Only the hashed token is persisted; the raw token is delivered to the invitee.
// ============================================================================

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  email          String
  organizationId String    @map("organization_id")
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  invitedById    String    @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([tokenHash])
  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ============================================================================
// VoIP Module — Multi-tenant reseller calling, SIP, wallet, billing, CDR
// ============================================================================

model VoipService {
  id                      String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId          String   @unique @map("organization_id")
  status                  String   @default("ACTIVE") // ACTIVE, LOW_BALANCE, ZERO_BALANCE
  isAdminSuspended        Boolean  @default(false) @map("is_admin_suspended")
  customerRate            Decimal  @default(0.016) @map("customer_rate") @db.Decimal(12, 6)
  billingIncrementSeconds Int      @default(60) @map("billing_increment_seconds")
  minimumBillableSeconds  Int      @default(60) @map("minimum_billable_seconds")
  reserveMinutes          Int      @default(5) @map("reserve_minutes")
  lowBalanceThresholds    Int[]    @map("low_balance_thresholds")
  maxCallDurationMinutes  Int      @default(60) @map("max_call_duration_minutes")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([isAdminSuspended])
  @@map("voip_services")
}

model Wallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @unique @map("organization_id")
  balance        Decimal  @default(0) @db.Decimal(12, 4)
  reserved       Decimal  @default(0) @db.Decimal(12, 4)
  currency       String   @default("USD")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  reservations WalletReservation[]

  @@index([organizationId])
  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  walletId       String   @map("wallet_id")
  type           String // CREDIT, DEBIT, REFUND, ADJUSTMENT, RESERVATION, RELEASE
  amount         Decimal  @db.Decimal(12, 4) // signed: positive for credit/reservation, negative for debit/release
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(12, 4)
  description    String?
  reference      String? // internal call id, invoice id, etc.
  idempotencyKey String?  @unique @map("idempotency_key")
  metadata       Json?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("WalletTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

model WalletReservation {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  walletId    String    @map("wallet_id")
  callId      String?   @unique @map("call_id")
  amount      Decimal   @db.Decimal(12, 4)
  status      String    @default("ACTIVE") // ACTIVE, RELEASED, CONSUMED
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  releasedAt  DateTime? @map("released_at")

  wallet Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  call   VoipCall? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([callId])
  @@index([status])
  @@map("wallet_reservations")
}

model SipAccount {
  id                   String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId       String   @map("organization_id")
  username             String
  passwordCipher       String   @map("password_cipher")
  passwordTag          String   @map("password_tag")
  passwordIv           String   @map("password_iv")
  domain               String
  status               String   @default("ACTIVE") // ACTIVE, DISABLED
  maxConcurrentCalls   Int      @default(1) @map("max_concurrent_calls")
  callerId             String?  @map("caller_id")
  providerConnectionId String?  @map("provider_connection_id")
  providerConfig       Json?    @map("provider_config")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls        VoipCall[]
  phoneNumbers PhoneNumber[]

  @@unique([organizationId, username])
  @@index([organizationId])
  @@index([status])
  @@index([providerConnectionId])
  @@map("sip_accounts")
}

model PhoneNumber {
  id                   String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId       String   @map("organization_id")
  sipAccountId         String?  @map("sip_account_id")
  carrierId            String?  @map("carrier_id") // future per-number carrier assignment
  number               String // E.164
  displayNumber        String?  @map("display_number")
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE
  provider             String   @default("telnyx")
  providerNumberId     String?  @map("provider_number_id")
  providerConnectionId String?  @map("provider_connection_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sipAccount   SipAccount?  @relation(fields: [sipAccountId], references: [id], onDelete: SetNull)
  carrier      Carrier?     @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  calls        VoipCall[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([number])
  @@index([sipAccountId])
  @@index([carrierId])
  @@index([providerNumberId])
  @@index([providerConnectionId])
  @@map("phone_numbers")
}

model Carrier {
  id                      String          @id @default(dbgenerated("gen_random_uuid()"))
  organizationId          String?         @map("organization_id") // null = platform-wide carrier
  name                    String
  code                    String          @unique // e.g. "teloz", "telnyx", "twilio"
  type                    CarrierType
  enabled                 Boolean         @default(true)
  status                  CarrierStatus   @default(TEST)
  authenticationType      CarrierAuthType @map("authentication_type")
  remoteHost              String?         @map("remote_host")
  remotePort              Int?            @map("remote_port")
  transport               Transport       @default(UDP)
  localHost               String?         @map("local_host")
  localPort               Int?            @map("local_port")
  techPrefix              String?         @map("tech_prefix")
  codecs                  String[]
  maxChannels             Int?            @map("max_channels")
  maxCps                  Int?            @map("max_cps")
  billingIncrementSeconds Int             @default(60) @map("billing_increment_seconds")
  minimumBillableSeconds  Int             @default(60) @map("minimum_billable_seconds")
  defaultCallerId         String?         @map("default_caller_id")
  cliMode                 CliMode         @default(PASS_THROUGH) @map("cli_mode")
  notes                   String?
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential    CarrierCredential?
  rates         CarrierRate[]
  cliProfiles   CarrierCliProfile[]
  routePolicies CarrierRoutePolicy[]
  phoneNumbers  PhoneNumber[]
  calls         VoipCall[]
  provider      Provider?

  @@index([organizationId])
  @@index([code])
  @@index([enabled])
  @@index([status])
  @@map("carriers")
}

model CarrierCredential {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  carrierId      String   @unique @map("carrier_id")
  username       String?
  passwordCipher String   @map("password_cipher")
  passwordTag    String   @map("password_tag")
  passwordIv     String   @map("password_iv")
  realm          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@map("carrier_credentials")
}

model CarrierRate {
  id                      String          @id @default(dbgenerated("gen_random_uuid()"))
  carrierId               String          @map("carrier_id")
  prefix                  String // digits without leading '+', e.g. "30", "3069", "38640"
  country                 String? // ISO-3166-1 alpha-2, e.g. "GR"
  destinationType         DestinationType @map("destination_type")
  rate                    Decimal         @db.Decimal(12, 6) // per minute
  billingIncrementSeconds Int             @default(60) @map("billing_increment_seconds")
  minimumBillableSeconds  Int             @default(60) @map("minimum_billable_seconds")
  effectiveFrom           DateTime        @default(now()) @map("effective_from")
  effectiveTo             DateTime?       @map("effective_to")
  priority                Int             @default(0)
  enabled                 Boolean         @default(true)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  carrier Carrier    @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  calls   VoipCall[]

  // No unique constraint across (carrierId, prefix, destinationType) because multiple
  // effective-dated rate versions must be able to coexist (e.g. old and new rate).
  // Routing logic will select the currently effective record.
  // priority is reserved for future routing decisions, not for rate-history identity.
  @@index([carrierId])
  @@index([prefix])
  @@index([country])
  @@index([destinationType])
  @@index([enabled])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([priority])
  @@index([carrierId, prefix, destinationType, enabled, effectiveFrom, effectiveTo])
  @@map("carrier_rates")
}

model CarrierCliProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  carrierId  String   @map("carrier_id")
  name       String
  defaultCli String?  @map("default_cli")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  carrier       Carrier              @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  entries       CarrierCliEntry[]
  routePolicies CarrierRoutePolicy[]

  @@index([carrierId])
  @@map("carrier_cli_profiles")
}

model CarrierCliEntry {
