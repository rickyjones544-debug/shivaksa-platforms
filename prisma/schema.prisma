// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 3: Multi-tenant foundation
// - User is global; authentication happens at the User level.
// - Organization is the tenant isolation boundary.
// - OrganizationMembership ties a User to an Organization with a Role.
// - Session captures the active membership context for a login.

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("PENDING") // ACTIVE, PENDING, SUSPENDED (global/platform status)
  isSuperAdmin Boolean  @default(false) @map("is_super_admin") // platform-wide super admin
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sessions       Session[]
  passwordResets PasswordReset[]
  memberships    OrganizationMembership[]

  // CRM relations
  createdContacts Contact[]
  createdLeads    Lead[] @relation("CreatedLeads")
  assignedLeads   Lead[] @relation("AssignedLeads")
  createdCampaigns Campaign[]
  createdNotes    Note[]

  @@index([email])
  @@index([status])
  @@index([isSuperAdmin])
  @@map("users")
}

// Tenant isolation boundary. Every business record belongs to exactly one Organization.
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships OrganizationMembership[]

  // CRM relations
  contacts  Contact[]
  leads     Lead[]
  campaigns Campaign[]
  notes     Note[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// RBAC anchor: a user's role within a specific organization.
// A user may belong to multiple organizations with different roles.
model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  status         String   @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  joinedAt       DateTime @default(now()) @map("joined_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  sessions     Session[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_memberships")
}

// System + custom roles. isSystem prevents accidental deletion of built-in roles.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@index([name])
  @@map("roles")
}

// Permission definition. scope + action (+ optional resource) form the permission key.
model Permission {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  scope    String  // e.g. "crm", "bpo", "admin"
  action   String  // e.g. "read", "write", "delete", "manage"
  resource String? // e.g. "leads", "contacts"; null means all resources in scope

  roles RolePermission[]

  @@unique([scope, action, resource])
  @@index([scope])
  @@map("permissions")
}

// Many-to-many join between Role and Permission.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Session model - server-side session storage.
// Phase 3: session now carries the active membership context for tenant routing/RBAC.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash    String   @unique @map("token_hash")
  userId       String   @map("user_id")
  membershipId String?  @map("membership_id") // active tenant context; nullable until chosen
  expiresAt    DateTime @map("expires_at")
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

// Password reset tokens - short-lived, one-time use.
model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}

// ============================================================================
// CRM Module — Step 3
// Every CRM record is scoped to an Organization. Notes may attach to contacts,
// leads, or campaigns, but always carry organizationId for tenant isolation.
// ============================================================================

model Contact {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  email          String?
  phone          String?
  company        String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  leads        Lead[]
  notes        Note[]

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("contacts")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  contactId      String?  @map("contact_id")
  title          String
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST, WON
  value          Decimal? @db.Decimal(12, 2)
  source         String?
  assignedToId   String?  @map("assigned_to_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CreatedLeads", fields: [createdById], references: [id])
  campaigns    CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contactId])
  @@map("leads")
}

model Campaign {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  name           String
  status         String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  leads        CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("campaigns")
}

// Join table between Campaigns and Leads. organizationId is denormalized for
// tenant-scoped queries and must match the owning campaign/lead organization.
model CampaignLead {
  id             String @id @default(dbgenerated("gen_random_uuid()"))
  campaignId     String @map("campaign_id")
  leadId         String @map("lead_id")
  organizationId String @map("organization_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
  @@map("campaign_leads")
}

model Note {
  id             String  @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String  @map("organization_id")
  content        String
  contactId      String? @map("contact_id")
  leadId         String? @map("lead_id")
  campaignId     String? @map("campaign_id")
  createdById    String  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([campaignId])
  @@map("notes")
}
