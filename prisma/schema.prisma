// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 3: Multi-tenant foundation
// - User is global; authentication happens at the User level.
// - Organization is the tenant isolation boundary.
// - OrganizationMembership ties a User to an Organization with a Role.
// - Session captures the active membership context for a login.

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("PENDING") // ACTIVE, PENDING, SUSPENDED (global/platform status)
  isSuperAdmin Boolean  @default(false) @map("is_super_admin") // platform-wide super admin
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sessions       Session[]
  passwordResets PasswordReset[]
  memberships    OrganizationMembership[]
  invitationsSent Invitation[]

  // CRM relations
  createdContacts Contact[]
  createdLeads    Lead[] @relation("CreatedLeads")
  assignedLeads   Lead[] @relation("AssignedLeads")
  createdCampaigns Campaign[]
  createdNotes    Note[]

  // VoIP relations
  walletTransactions WalletTransaction[] @relation("WalletTransactionCreator")
  auditLogs         AuditLog[] @relation("AuditLogActor")
  notifications     Notification[]

  @@index([email])
  @@index([status])
  @@index([isSuperAdmin])
  @@map("users")
}

// Tenant isolation boundary. Every business record belongs to exactly one Organization.
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships OrganizationMembership[]
  invitations Invitation[]

  // CRM relations
  contacts  Contact[]
  leads     Lead[]
  campaigns Campaign[]
  notes     Note[]

  // VoIP relations
  voipService  VoipService?
  wallet       Wallet?
  sipAccounts  SipAccount[]
  phoneNumbers PhoneNumber[]
  voipCalls    VoipCall[]
  notifications Notification[]
  auditLogs    AuditLog[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

// RBAC anchor: a user's role within a specific organization.
// A user may belong to multiple organizations with different roles.
model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  status         String   @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  joinedAt       DateTime @default(now()) @map("joined_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  sessions     Session[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_memberships")
}

// System + custom roles. isSystem prevents accidental deletion of built-in roles.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  memberships OrganizationMembership[]
  invitations Invitation[]

  @@index([name])
  @@map("roles")
}

// Permission definition. `key` is the canonical stable identifier used for
// lookups and assignment. scope/action/resource remain for documentation/grouping.
model Permission {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  key      String  @unique // canonical key, e.g. "crm:read:contacts"
  scope    String  // e.g. "crm", "bpo", "admin"
  action   String  // e.g. "read", "write", "delete", "manage"
  resource String? // e.g. "leads", "contacts"; null means all resources in scope

  roles RolePermission[]

  @@index([scope])
  @@map("permissions")
}

// Many-to-many join between Role and Permission.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Session model - server-side session storage.
// Phase 3: session now carries the active membership context for tenant routing/RBAC.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash    String   @unique @map("token_hash")
  userId       String   @map("user_id")
  membershipId String?  @map("membership_id") // active tenant context; nullable until chosen
  expiresAt    DateTime @map("expires_at")
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

// Password reset tokens - short-lived, one-time use.
model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}

// ============================================================================
// CRM Module — Step 3
// Every CRM record is scoped to an Organization. Notes may attach to contacts,
// leads, or campaigns, but always carry organizationId for tenant isolation.
// ============================================================================

model Contact {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  email          String?
  phone          String?
  company        String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  leads        Lead[]
  notes        Note[]

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("contacts")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  contactId      String?  @map("contact_id")
  title          String
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST, WON
  value          Decimal? @db.Decimal(12, 2)
  source         String?
  assignedToId   String?  @map("assigned_to_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CreatedLeads", fields: [createdById], references: [id])
  campaigns    CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contactId])
  @@map("leads")
}

model Campaign {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  name           String
  status         String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  leads        CampaignLead[]
  notes        Note[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("campaigns")
}

// Join table between Campaigns and Leads. organizationId is denormalized for
// tenant-scoped queries and must match the owning campaign/lead organization.
model CampaignLead {
  id             String @id @default(dbgenerated("gen_random_uuid()"))
  campaignId     String @map("campaign_id")
  leadId         String @map("lead_id")
  organizationId String @map("organization_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
  @@map("campaign_leads")
}

model Note {
  id             String  @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String  @map("organization_id")
  content        String
  contactId      String? @map("contact_id")
  leadId         String? @map("lead_id")
  campaignId     String? @map("campaign_id")
  createdById    String  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([campaignId])
  @@map("notes")
}

// ============================================================================
// Organization Invitations � Step 4
// Secure, expirable, single-use tokens for inviting users into organizations.
// Only the hashed token is persisted; the raw token is delivered to the invitee.
// ============================================================================

model Invitation {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  email          String
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  tokenHash      String   @unique @map("token_hash")
  status         String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  invitedById    String   @map("invited_by_id")
  expiresAt      DateTime @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([tokenHash])
  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ============================================================================
// VoIP Module — Multi-tenant reseller calling, SIP, wallet, billing, CDR
// ============================================================================

model VoipService {
  id                     String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId         String   @unique @map("organization_id")
  status                 String   @default("ACTIVE") // ACTIVE, LOW_BALANCE, ZERO_BALANCE
  isAdminSuspended       Boolean  @default(false) @map("is_admin_suspended")
  customerRate           Decimal  @default(0.016) @map("customer_rate") @db.Decimal(12, 6)
  billingIncrementSeconds Int     @default(60) @map("billing_increment_seconds")
  minimumBillableSeconds  Int     @default(60) @map("minimum_billable_seconds")
  reserveMinutes         Int      @default(5) @map("reserve_minutes")
  lowBalanceThresholds   Int[]    @map("low_balance_thresholds")
  maxCallDurationMinutes Int      @default(60) @map("max_call_duration_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([isAdminSuspended])
  @@map("voip_services")
}

model Wallet {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String @unique @map("organization_id")
  balance      Decimal @default(0) @db.Decimal(12, 4)
  reserved     Decimal @default(0) @db.Decimal(12, 4)
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  reservations  WalletReservation[]

  @@index([organizationId])
  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  walletId       String   @map("wallet_id")
  type           String   // CREDIT, DEBIT, REFUND, ADJUSTMENT
  amount         Decimal  @db.Decimal(12, 4) // signed: positive for credit, negative for debit
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(12, 4)
  description    String?
  reference      String?  // internal call id, invoice id, etc.
  metadata       Json?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("WalletTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

model WalletReservation {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  walletId    String    @map("wallet_id")
  callId      String?   @unique @map("call_id")
  amount      Decimal   @db.Decimal(12, 4)
  status      String    @default("ACTIVE") // ACTIVE, RELEASED, CONSUMED
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  releasedAt  DateTime? @map("released_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  call   VoipCall? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([callId])
  @@index([status])
  @@map("wallet_reservations")
}

model SipAccount {
  id                   String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId       String   @map("organization_id")
  username             String
  passwordCipher       String   @map("password_cipher")
  passwordTag          String   @map("password_tag")
  passwordIv           String   @map("password_iv")
  domain               String
  status               String   @default("ACTIVE") // ACTIVE, DISABLED
  maxConcurrentCalls   Int      @default(1) @map("max_concurrent_calls")
  callerId             String?  @map("caller_id")
  providerConnectionId String?  @map("provider_connection_id")
  providerConfig       Json?    @map("provider_config")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls         VoipCall[]
  phoneNumbers  PhoneNumber[]

  @@unique([organizationId, username])
  @@index([organizationId])
  @@index([status])
  @@index([providerConnectionId])
  @@map("sip_accounts")
}

model PhoneNumber {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId   String   @map("organization_id")
  sipAccountId     String?  @map("sip_account_id")
  number               String   // E.164
  displayNumber        String?  @map("display_number")
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE
  provider             String   @default("telnyx")
  providerNumberId     String?  @map("provider_number_id")
  providerConnectionId String?  @map("provider_connection_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sipAccount   SipAccount?  @relation(fields: [sipAccountId], references: [id], onDelete: SetNull)
  calls        VoipCall[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([number])
  @@index([sipAccountId])
  @@index([providerNumberId])
  @@index([providerConnectionId])
  @@map("phone_numbers")
}

model VoipCall {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  organizationId   String    @map("organization_id")
  sipAccountId     String?   @map("sip_account_id")
  phoneNumberId    String?   @map("phone_number_id")
  direction        String    // INBOUND, OUTBOUND
  callerId         String    @map("caller_id")
  destination      String
  status           String    @default("INITIATED") // INITIATED, RINGING, ANSWERED, COMPLETED, BUSY, NO_ANSWER, FAILED, REJECTED, CANCELLED
  provider         String    @default("telnyx")
  providerCallId   String?   @map("provider_call_id")
  startTime        DateTime? @map("start_time")
  answerTime       DateTime? @map("answer_time")
  endTime          DateTime? @map("end_time")
  durationSeconds  Int?      @map("duration_seconds")
  billableSeconds  Int?      @map("billable_seconds")
  billedMinutes    Decimal?  @map("billed_minutes") @db.Decimal(12, 4)
  customerRate     Decimal   @map("customer_rate") @db.Decimal(12, 6)
  customerCharge   Decimal?  @map("customer_charge") @db.Decimal(12, 4)
  wholesaleCost    Decimal?  @map("wholesale_cost") @db.Decimal(12, 4)
  grossProfit      Decimal?  @map("gross_profit") @db.Decimal(12, 4)
  failureReason    String?   @map("failure_reason")
  routingInfo      Json?     @map("routing_info")
  reservationId    String?   @map("reservation_id")
  billingProcessed Boolean   @default(false) @map("billing_processed")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sipAccount    SipAccount?         @relation(fields: [sipAccountId], references: [id], onDelete: SetNull)
  phoneNumber   PhoneNumber?      @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  reservation   WalletReservation?
  webhookEvents WebhookEvent[]

  @@index([organizationId])
  @@index([sipAccountId])
  @@index([phoneNumberId])
  @@index([provider, providerCallId])
  @@index([status])
  @@index([createdAt])
  @@index([destination])
  @@index([startTime])
  @@map("voip_calls")
}

model WebhookEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  provider         String
  providerEventId    String    @map("provider_event_id")
  eventType        String    @map("event_type")
  payload          Json
  status           String    @default("PENDING") // PENDING, PROCESSED, FAILED
  callId           String?   @map("call_id")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  call VoipCall? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider, providerEventId])
  @@index([callId])
  @@index([status])
  @@map("webhook_events")
}

model Notification {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId   String   @map("organization_id")
  userId           String?  @map("user_id")
  type             String
  thresholdMinutes Int?     @map("threshold_minutes")
  message          String
  sentAt           DateTime @default(now()) @map("sent_at")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  actorId        String?   @map("actor_id")
  organizationId String?   @map("organization_id")
  action         String
  resource       String
  resourceId     String?   @map("resource_id")
  metadata       Json?
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")

  actor        User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
