// ============================================================================
// Provider CRM — wholesale carrier relationship management (internal)
// organizationId is the OWNING Shivaksa organization, not the provider's
// tenant; providers are counterparties, not platform tenants.
// ============================================================================

model Provider {
  id             String                  @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String                  @map("organization_id")
  companyName    String                  @map("company_name")
  tradingName    String?                 @map("trading_name")
  website        String?
  country        String?
  lifecycleStage ProviderLifecycleStage  @default(PROSPECT) @map("lifecycle_stage")
  status         String                  @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  carrierId      String?                 @unique @map("carrier_id") // optional link to live traffic config
  stageChangedAt DateTime                @default(now()) @map("stage_changed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carrier      Carrier?             @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  contacts     ProviderContact[]
  submissions  ProviderSubmission[]
  notes        ProviderNote[]
  tasks        ProviderTask[]
  rateSheets   ProviderRateSheet[]
  rates        ProviderRate[]

  @@index([organizationId])
  @@index([lifecycleStage])
  @@index([status])
  @@index([country])
  @@map("providers")
}

model ProviderContact {
  id         String              @id @default(dbgenerated("gen_random_uuid()"))
  providerId String              @map("provider_id")
  role       ProviderContactRole
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([role])
  @@map("provider_contacts")
}

// Tokenized read-only onboarding links for prospective providers (Model A).
// Raw token is never stored; only the SHA-256 hash.
model OnboardingLink {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  organizationId    String    @map("organization_id")
  tokenHash         String    @unique @map("token_hash")
  label             String?
  expiresAt         DateTime? @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  maxSubmissions    Int?      @map("max_submissions")
  accessCodeHash    String?   @map("access_code_hash")
  viewCount         Int       @default(0) @map("view_count")
  submissionCount   Int       @default(0) @map("submission_count")
  lastViewedAt      DateTime? @map("last_viewed_at")
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("OnboardingLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions  ProviderSubmission[]
  documents    ProviderSubmissionDocument[]

  @@index([tokenHash])
  @@index([organizationId])
  @@map("onboarding_links")
}

// Structured intake from a provider-facing onboarding form. Submissions land
// here only; promotion to a Provider record is a manual staff action.
model ProviderSubmission {
  id              String                   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId  String                   @map("organization_id")
  onboardingLinkId String?                 @map("onboarding_link_id")
  providerId      String?                  @map("provider_id") // set when promoted to a Prospect
  companyName     String                   @map("company_name")
  website         String?
  country         String?
  contactEmail    String?                  @map("contact_email")
  status          ProviderSubmissionStatus @default(NEW)
  payload         Json                     // full questionnaire data (company, contacts, rates, technical, commercial)
  reviewedById    String?                  @map("reviewed_by_id")
  reviewedAt      DateTime?                @map("reviewed_at")
  reviewNotes     String?                  @map("review_notes")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboardingLink OnboardingLink? @relation(fields: [onboardingLinkId], references: [id], onDelete: SetNull)
  provider       Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  reviewedBy     User?           @relation("ProviderSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents      ProviderSubmissionDocument[]

  @@index([organizationId])
  @@index([status])
  @@index([onboardingLinkId])
  @@index([providerId])
  @@index([contactEmail])
  @@map("provider_submissions")
}

// Provider-uploaded document metadata. Files live in private object storage —
// never in the public web root — addressed by a random storedObjectKey. Rows
// are created PENDING against an onboarding link and become ATTACHED to the
// submission snapshot when the provider submits intake.
model ProviderSubmissionDocument {
  id               String                           @id @default(dbgenerated("gen_random_uuid()"))
  organizationId   String                           @map("organization_id")
  onboardingLinkId String                           @map("onboarding_link_id")
  submissionId     String?                          @map("submission_id")
  category         ProviderDocumentCategory
  originalFileName String                           @map("original_file_name")
  storedObjectKey  String                           @unique @map("stored_object_key")
  mimeType         String                           @map("mime_type")
  sizeBytes        Int                              @map("size_bytes")
  description      String?
  status           ProviderSubmissionDocumentStatus @default(PENDING)
  scanStatus       String                           @default("NOT_SCANNED") @map("scan_status")
  createdAt        DateTime                         @default(now()) @map("created_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboardingLink OnboardingLink      @relation(fields: [onboardingLinkId], references: [id], onDelete: Cascade)
  submission     ProviderSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  rateSheets     ProviderRateSheet[]

  @@index([organizationId])
  @@index([onboardingLinkId])
  @@index([submissionId])
  @@index([status])
  @@map("provider_submission_documents")
}

// Internal-only notes. Never have a visibility flag — structurally internal.
model ProviderNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  providerId String   @map("provider_id")
  authorId   String?  @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  author   User?    @relation("ProviderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([authorId])
  @@map("provider_notes")
}

model ProviderTask {
  id          String            @id @default(dbgenerated("gen_random_uuid()"))
  providerId  String            @map("provider_id")
  type        ProviderTaskType  @default(GENERAL)
  status      ProviderTaskStatus @default(OPEN)
  title       String
  description String?
  assigneeId  String?           @map("assignee_id")
  dueDate     DateTime?         @map("due_date")
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  provider  Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  assignee  User?    @relation("ProviderTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("ProviderTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("provider_tasks")
}

// ============================================================================
// Requirements Center — Shivaksa's internal source of truth for what it
// requires from wholesale traffic providers. Org-owned, never provider-owned.
//
// RequirementSet        = live working definition (sections editable)
// RequirementVersion    = immutable version snapshot of the set
// RequirementVersionSection = immutable section snapshots inside a version
// ============================================================================

model RequirementSet {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String              @map("organization_id")
  name           String
  description    String?
  status         RequirementSetStatus @default(DRAFT)
  // Points at RequirementVersion.versionNumber — a scalar, not an FK, to
  // avoid a circular dependency and keep versions historically independent.
  currentVersion Int?                @map("current_version")
  createdById    String?             @map("created_by_id")
  updatedById    String?             @map("updated_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("RequirementSetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                @relation("RequirementSetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  sections     RequirementSection[]
  versions     RequirementVersion[]
  wholesaleProfiles WholesaleProfile[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
  @@map("requirement_sets")
}

// Live section of a RequirementSet. `key` is a stable string identifier
// (COMPANY_PROFILE, TRAFFIC_PROFILE, ...) validated at the application layer.
// INTERNAL = never leaves internal scope. PUBLISHABLE = eligible for a future
// provider-facing Wholesale Profile; does not imply public access.
model RequirementSection {
  id               String                @id @default(dbgenerated("gen_random_uuid()"))
  requirementSetId String                @map("requirement_set_id")
  key              String
  title            String
  description      String?
  sortOrder        Int                   @default(0) @map("sort_order")
  visibility       RequirementVisibility @default(INTERNAL)
  isRequired       Boolean               @default(true) @map("is_required")
  content          Json?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  requirementSet RequirementSet @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)

  @@unique([requirementSetId, key])
  @@index([requirementSetId])
  @@index([visibility])
  @@map("requirement_sections")
}

model RequirementVersion {
  id               String                   @id @default(dbgenerated("gen_random_uuid()"))
  requirementSetId String                   @map("requirement_set_id")
  versionNumber    Int                      @map("version_number")
  status           RequirementVersionStatus @default(DRAFT)
  changeSummary    String?                  @map("change_summary")
  createdById      String?                  @map("created_by_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  publishedById    String?                  @map("published_by_id")
  publishedAt      DateTime?                @map("published_at")

  requirementSet RequirementSet              @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)
  createdBy      User?                       @relation("RequirementVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy    User?                       @relation("RequirementVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  sections       RequirementVersionSection[]

  @@unique([requirementSetId, versionNumber])
  @@index([requirementSetId])
  @@index([status])
  @@map("requirement_versions")
}

model RequirementVersionSection {
  id                   String                @id @default(dbgenerated("gen_random_uuid()"))
  requirementVersionId String                @map("requirement_version_id")
  key                  String
  title                String
  description          String?
  sortOrder            Int                   @default(0) @map("sort_order")
  visibility           RequirementVisibility @default(INTERNAL)
  isRequired           Boolean               @default(true) @map("is_required")
  content              Json?
  createdAt            DateTime              @default(now()) @map("created_at")

  requirementVersion RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Cascade)

  @@unique([requirementVersionId, key])
  @@index([requirementVersionId])
  @@index([visibility])
  @@map("requirement_version_sections")
}

// ============================================================================
// Wholesale Profile — the provider-facing presentation configuration.
// Org-owned (Shivaksa), one profile per organization. It does NOT duplicate
// requirement content; it points at a published RequirementVersion of the
// organization's RequirementSet and provider-safe resolution reads the
// immutable RequirementVersionSection snapshots.
// publishedVersionNumber is a scalar pointer (same design as
// RequirementSet.currentVersion) — no circular FK.
// ============================================================================

model WholesaleProfile {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()"))
  organizationId         String                 @map("organization_id")
  requirementSetId       String                 @map("requirement_set_id")
  publishedVersionNumber Int?                   @map("published_version_number")
  status                 WholesaleProfileStatus @default(DRAFT)
  title                  String
  subtitle               String?
  createdById            String?                @map("created_by_id")
  updatedById            String?                @map("updated_by_id")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirementSet RequirementSet @relation(fields: [requirementSetId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation("WholesaleProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?          @relation("WholesaleProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  // One primary wholesale profile per organization.
  @@unique([organizationId])
  @@index([requirementSetId])
  @@index([status])
  @@map("wholesale_profiles")
}

// ============================================================================
// Rate Desk models — internal provider rate management.
// Provider = upstream supplier (CRM). ProviderRateSheet = a rate offer/document
// received from that provider. Versions are immutable once PUBLISHED; rate rows
// hang off a version so history is never destructively overwritten.
// Structurally isolated from carriers/carrier_rates: a row here never activates
// routing — activation is a separate explicit internal action (future phase).
// ============================================================================

model ProviderRateSheet {
  id               String                  @id @default(dbgenerated("gen_random_uuid()"))
  organizationId   String                  @map("organization_id")
  providerId       String                  @map("provider_id")
  label            String
  source           ProviderRateSheetSource @default(MANUAL)
  sourceDocumentId String?                 @map("source_document_id")
  status           ProviderRateSheetStatus @default(RECEIVED)
  currentVersion   Int?                    @map("current_version")
  receivedAt       DateTime                @default(now()) @map("received_at")
  notes            String?
  createdById      String?                 @map("created_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       Provider                    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sourceDocument ProviderSubmissionDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdBy      User?                       @relation("ProviderRateSheetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions       ProviderRateSheetVersion[]

  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@index([sourceDocumentId])
  @@map("provider_rate_sheets")
}

// Immutable once PUBLISHED. Sheet.currentVersion is the pointer to the active
// published version number (same pattern as RequirementSet.currentVersion).
model ProviderRateSheetVersion {
  id             String                         @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String                         @map("organization_id")
  sheetId        String                         @map("sheet_id")
  version        Int
  status         ProviderRateSheetVersionStatus @default(DRAFT)
  publishedAt    DateTime?                      @map("published_at")
  publishedById  String?                        @map("published_by_id")
  notes          String?
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sheet        ProviderRateSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  publishedBy  User?              @relation("ProviderRateSheetVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  rates        ProviderRate[]

  @@unique([sheetId, version])
  @@index([organizationId])
  @@index([status])
  @@map("provider_rate_sheet_versions")
}

// A single provider-offered rate row. Decimal(14,8) supports sub-cent wholesale
// pricing and more precise future values; currency is an ISO-4217 code
// (USD/EUR today, additional codes are schema-compatible).
// Billing notation "first/increment" e.g. 60/1 = firstIncrementSeconds 60,
// incrementSeconds 1. minimumDurationSeconds is a separate chargeable floor.
model ProviderRate {
  id                     String                @id @default(dbgenerated("gen_random_uuid()"))
  organizationId         String                @map("organization_id")
  providerId             String                @map("provider_id")
  versionId              String                @map("version_id")
  destination            String?               // human-readable, e.g. "Greece Mobile"
  countryIso             String?               @map("country_iso") // ISO-3166-1 alpha-2
  prefix                 String                // digits only, no leading '+'
  routeType              ProviderRateRouteType @map("route_type")
  rate                   Decimal               @db.Decimal(14, 8) // per minute
  currency               String                @default("USD")
  firstIncrementSeconds  Int                   @default(1) @map("first_increment_seconds")
  incrementSeconds       Int                   @default(1) @map("increment_seconds")
  minimumDurationSeconds Int                   @default(0) @map("minimum_duration_seconds")
  effectiveFrom          DateTime              @default(now()) @map("effective_from")
  effectiveTo            DateTime?             @map("effective_to")
  notes                  String?
  createdAt              DateTime              @default(now()) @map("created_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  version      ProviderRateSheetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([providerId])
  @@index([versionId])
  @@index([prefix])
  @@index([countryIso])
  @@index([organizationId, providerId, prefix, routeType, effectiveFrom, effectiveTo])
  @@map("provider_rates")
}
