# Database
DATABASE_URL=postgresql://postgres:your-password@db.jismtekyryududjccxdc.supabase.co:5432/postgres?sslmode=require

# Application
AUTH_SECRET=your-random-secret-key-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000
APPLICATION_URL=http://localhost:3000
WEBHOOK_URL=https://app.shivaksatechnology.com
NODE_ENV=development

# AI Providers
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VoIP Providers
TELNYX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_CONNECTION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
TWILIO_ACCOUNT_SID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SIP / Branding
SIP_DOMAIN=sip.shivaksatechnology.com

# Isolated WebRTC echo test (SUPER_ADMIN only, server-side only — never NEXT_PUBLIC_*)
WEBRTC_TEST_SIP_URI=sip:your-test-endpoint@example.com
WEBRTC_TEST_SIP_USERNAME=your-test-endpoint-username
WEBRTC_TEST_SIP_PASSWORD=your-test-endpoint-password
WEBRTC_TEST_WSS_URL=wss://your-domain/ws

# Storage
# Private object storage for provider submission documents.
# OBJECT_STORAGE_BACKEND: local | s3 (default: local)
# local → files stored under OBJECT_STORAGE_DIR (default <app>/storage/private,
#         outside the public web root, never served over HTTP).
# s3    → requires AWS_* credentials AND an S3 client implementation; fails
#         closed until configured.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_DIR=
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=shivaksa-platform-uploads

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-for-sensitive-data
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Session
SESSION_MAX_AGE=604800
SESSION_SECRET=another-random-secret-key-minimum-32-characters

# One-time first administrator bootstrap (server-side CLI only)
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Platform Owner
BOOTSTRAP_ORGANIZATION_NAME=Shivaksa Technologies
BOOTSTRAP_TOKEN_HASH=replace-with-64-character-sha256-hex
